{
  "manifest_version": 3,
  "name": "Send to Google Docs - Smart Organizer",
  "version": "2.0.0",
  "description": "One-click save AI answers to organized Google Docs with folders, tags, and smart metadata",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://www.perplexity.ai/*",
    "https://comet.com/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://docs.google.com/*",
    "https://www.googleapis.com/*",
    "https://drive.google.com/*"
  ],
  "background": {
    "service_worker": "background-enhanced.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.perplexity.ai/*",
        "https://comet.com/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content-v2.js"],
      "css": ["styles-enhanced.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID_HERE.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/documents",
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/drive.metadata.readonly"
    ]
  }
}
